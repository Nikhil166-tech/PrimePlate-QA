# ==================================================
# PrimePlate Environment Variables Template
# ==================================================

# Supabase PostgreSQL Connection Pooler URL (IPv4 port 6543)
# For QA: dedicated QA Supabase project database
# e.g.: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://username:password@hostname:6543/postgres
DATABASE_SSL=true

PORT=5000
NODE_ENV=development
ENABLE_SEED=false
FRONTEND_URL=http://localhost:5173

# Cryptographically strong 256-bit keys (Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_256_bit_random_hex_string_here
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_256_bit_random_hex_string_here

# Razorpay: In QA, use rzp_test_ keys. Live mode (rzp_live_) is strictly for production.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloudinary Configuration (CLOUDINARY_FOLDER isolates QA uploads from production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=primeplate_qa

# Email / SMTP Configuration (Use sandbox/isolated SMTP in QA like Mailtrap, Mailgun Sandbox, or Ethereal)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SUPPORT_EMAIL=qa-support@primeplate.test
EMAIL_FROM=PrimePlate QA <qa-notifications@primeplate.test>

# Mailtrap Email Sending API (Official Mailtrap SDK)
# Obtain your API token at https://mailtrap.io/sending/api-tokens
# Check sent logs at https://mailtrap.io/sending/email_logs
MAILTRAP_TOKEN=your_mailtrap_api_token
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co
MAILTRAP_SENDER_NAME=Mailtrap Test

